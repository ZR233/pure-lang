* text=auto eol=lf

*.gitattributes text eol=lf
.editorconfig text eol=lf
*.sh text eol=lf

# Windows-native scripts and resources keep their platform line endings.
*.ps1 text eol=crlf
*.rc text eol=crlf
*.iss text eol=crlf

code/anywork/*/flutter/generated_plugin_registrant.cc text eol=lf
code/anywork/*/flutter/generated_plugin_registrant.h text eol=lf
code/anywork/*/flutter/generated_plugins.cmake text eol=lf

# Canonical Flutter/Rust generator outputs use LF on every platform. Keep them
# stable on Windows so code generation does not create CRLF-only worktree diffs.
code/anywork/lib/**/*.g.dart text eol=lf
code/anywork/lib/**/*.freezed.dart text eol=lf
code/anywork/lib/src/l10n/app_localizations*.dart text eol=lf
code/anywork/lib/src/rust/** text eol=lf
code/anywork/rust/src/frb_generated.rs text eol=lf
