import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { ChatMessageRow, ProjectRow, SessionRow } from "../types.slint";

export component ChatPage inherits Rectangle {
    in property <[ProjectRow]> projects;
    in property <[SessionRow]> sessions;
    in property <[ChatMessageRow]> messages;
    in-out property <string> manual_project_path;
    in-out property <string> prompt_text;
    in property <string> selected_project_id;
    in property <string> selected_session_id;
    in property <string> status_text;
    in property <string> streaming_text;
    in property <string> thinking_text;
    in property <bool> is_busy;
    in property <bool> approval_visible;
    in property <string> approval_id;
    in property <string> approval_text;

    callback add_project_dialog();
    callback add_project_path(string);
    callback select_project(string);
    callback new_session();
    callback select_session(string);
    callback send_prompt(string);
    callback show_settings();
    callback approve_tool(string);
    callback deny_tool(string);

    background: #faf9f7;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 300px;
            background: #2d2d30;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Pure Studio";
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Chat";
                    }
                    Button {
                        text: "Settings";
                        clicked => { root.show_settings(); }
                    }
                }

                Text {
                    text: "Projects";
                    color: #e0e0e0;
                    font-size: 13px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.manual_project_path;
                        placeholder-text: "Project path";
                    }
                    Button {
                        text: "+";
                        clicked => { root.add_project_path(root.manual_project_path); }
                    }
                }

                Button {
                    text: "Choose Folder";
                    clicked => { root.add_project_dialog(); }
                }

                ScrollView {
                    height: 200px;
                    viewport-width: parent.width;
                    VerticalLayout {
                        spacing: 6px;
                        for project in root.projects : Button {
                            text: project.name;
                            checked: project.id == root.selected_project_id;
                            clicked => { root.select_project(project.id); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Sessions";
                        color: #e0e0e0;
                        font-size: 13px;
                        font-weight: 700;
                    }
                    Button {
                        text: "+";
                        enabled: root.selected_project_id != "";
                        clicked => { root.new_session(); }
                    }
                }

                ScrollView {
                    viewport-width: parent.width;
                    VerticalLayout {
                        spacing: 6px;
                        for session in root.sessions : Button {
                            text: session.title;
                            checked: session.id == root.selected_session_id;
                            clicked => { root.select_session(session.id); }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Rectangle {
                    height: 48px;
                    background: #ffffff;
                    border-color: #e1dfdd;
                    border-width: 1px;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: "Conversation";
                            font-size: 22px;
                            font-weight: 700;
                            color: #1b1a19;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.status_text;
                            color: #605e5c;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                ScrollView {
                    viewport-width: parent.width;
                    VerticalLayout {
                        spacing: 8px;
                        for message in root.messages : Rectangle {
                            background: message.role == "user" ? #deecf9 : #f3f2f1;
                            border-radius: 8px;
                            min-height: 48px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: message.role;
                                    color: #605e5c;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: message.content;
                                    color: #1b1a19;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Rectangle {
                            visible: root.thinking_text != "";
                            background: #fff4ce;
                            border-radius: 8px;
                            min-height: 46px;
                            Text {
                                text: root.thinking_text;
                                color: #835500;
                                wrap: word-wrap;
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                            }
                        }
                        Rectangle {
                            visible: root.streaming_text != "";
                            background: #dff6dd;
                            border-radius: 8px;
                            min-height: 60px;
                            Text {
                                text: root.streaming_text;
                                color: #0b7940;
                                wrap: word-wrap;
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                            }
                        }
                    }
                }

                Rectangle {
                    visible: root.approval_visible;
                    height: 120px;
                    background: #fde7e9;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: root.approval_text;
                            color: #c42b1c;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Approve";
                                clicked => { root.approve_tool(root.approval_id); }
                            }
                            Button {
                                text: "Deny";
                                clicked => { root.deny_tool(root.approval_id); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.prompt_text;
                        placeholder-text: root.selected_session_id == "" ? "Create or select a session" : "Ask Pure Studio";
                        enabled: root.selected_session_id != "" && !root.is_busy;
                        accepted => { root.send_prompt(root.prompt_text); }
                    }
                    Button {
                        text: root.is_busy ? "Running" : "Send";
                        enabled: root.selected_session_id != "" && root.prompt_text != "" && !root.is_busy;
                        clicked => { root.send_prompt(root.prompt_text); }
                    }
                }
            }
        }
    }
}
