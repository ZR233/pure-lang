import { ProviderRow } from "../types.slint";
import { ProviderSettingsPage } from "provider_settings_page.slint";

component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <int> active_index;
    callback selected(int);

    preferred-width: 108px;
    min-width: 72px;
    height: 36px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.index == root.active_index ? #ffffff : transparent;
    border-color: root.index == root.active_index ? #d6e2ec : transparent;
    border-width: root.index == root.active_index ? 1px : 0px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.index == root.active_index ? #096895 : #5a6878;
        font-size: 13px;
        font-weight: root.index == root.active_index ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.selected(root.index); }
    }
}

export component SettingsPage inherits Rectangle {
    in property <[ProviderRow]> providers;
    in-out property <string> provider_search_text;
    in property <string> selected_provider_id;
    in property <string> selected_provider_name;
    in property <string> selected_provider_subtitle;
    in property <string> selected_provider_status;
    in property <string> selected_provider_base_url;
    in property <string> selected_provider_models;
    in property <string> selected_provider_wire_api;
    in property <string> selected_provider_updated_at;
    in property <string> status_text;
    in property <int> active_settings_tab;

    callback show_chat();
    callback select_settings_tab(int);
    callback add_provider_placeholder();
    callback select_provider(string);

    background: #f6f8fb;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 98px;
            background: #ffffff;
            border-color: #d9e0e8;
            border-width: 1px;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                spacing: 0px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 12px;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 6px;
                        background: #f0f4f8;

                        Text {
                            text: "←";
                            color: #1c2835;
                            font-size: 20px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.show_chat(); }
                        }
                    }

                    Text {
                        text: "Settings";
                        color: #111827;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.status_text;
                        color: #8895a4;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    preferred-width: 572px;
                    min-width: 400px;
                    max-width: 572px;
                    height: 44px;
                    border-radius: 8px;
                    background: #eef3f7;
                    border-color: #dce5ed;
                    border-width: 1px;

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        SettingsTab { label: "Providers"; index: 0; active_index: root.active_settings_tab; selected(index) => { root.select_settings_tab(index); } }
                        SettingsTab { label: "Models"; index: 1; active_index: root.active_settings_tab; selected(index) => { root.select_settings_tab(index); } }
                        SettingsTab { label: "Roles"; index: 2; active_index: root.active_settings_tab; selected(index) => { root.select_settings_tab(index); } }
                        SettingsTab { label: "Security"; index: 3; active_index: root.active_settings_tab; selected(index) => { root.select_settings_tab(index); } }
                        SettingsTab { label: "General"; index: 4; active_index: root.active_settings_tab; selected(index) => { root.select_settings_tab(index); } }
                    }
                }
            }
        }

        if root.active_settings_tab == 0 : ProviderSettingsPage {
            providers: root.providers;
            provider_search_text <=> root.provider_search_text;
            selected_provider_id: root.selected_provider_id;
            selected_provider_name: root.selected_provider_name;
            selected_provider_subtitle: root.selected_provider_subtitle;
            selected_provider_status: root.selected_provider_status;
            selected_provider_base_url: root.selected_provider_base_url;
            selected_provider_models: root.selected_provider_models;
            selected_provider_wire_api: root.selected_provider_wire_api;
            selected_provider_updated_at: root.selected_provider_updated_at;
            add_provider_placeholder => { root.add_provider_placeholder(); }
            select_provider(id) => { root.select_provider(id); }
        }

        if root.active_settings_tab != 0 : Rectangle {
            background: #f6f8fb;
            VerticalLayout {
                padding: 48px;
                spacing: 12px;
                Text {
                    text: "Coming soon";
                    color: #151c28;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "This settings tab will be wired in a later iteration.";
                    color: #657386;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
