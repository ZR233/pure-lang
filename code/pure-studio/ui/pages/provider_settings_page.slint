import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { ProviderRow } from "../types.slint";

component ProviderNameCell inherits Rectangle {
    in property <string> name;
    in property <string> subtitle;

    min-width: 130px;
    horizontal-stretch: 2;

    HorizontalLayout {
        spacing: 10px;

        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: 4px;
            background: #deecf9;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.name == "OpenAI" ? "AI" : "DS";
                color: #0078d4;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            min-width: 80px;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.name;
                color: #1b1a19;
                font-size: 15px;
                font-weight: 700;
            }

            Text {
                text: root.subtitle;
                color: #605e5c;
                font-size: 12px;
            }
        }
    }
}

component StatusCell inherits Rectangle {
    in property <string> status;

    width: 72px;

    VerticalLayout {
        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 70px;
                height: 24px;
                border-radius: 12px;
                background: root.status == "Healthy" ? #dff6dd : #fff4ce;
                border-color: root.status == "Healthy" ? #a4cfba : #e3cc93;
                border-width: 1px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.status;
                    color: root.status == "Healthy" ? #0b7940 : #835500;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

component TextCell inherits Rectangle {
    in property <string> text;

    min-width: 120px;
    horizontal-stretch: 2;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #1b1a19;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component FixedTextCell inherits Rectangle {
    in property <string> text;
    in property <bool> align_center;

    width: 88px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #605e5c;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: root.align_center ? center : left;
    }
}

component HeaderTextCell inherits Rectangle {
    in property <string> text;
    in property <bool> align_center;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #605e5c;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: root.align_center ? center : left;
    }
}

component ProviderHeaderCell inherits Rectangle {
    min-width: 132px;
    horizontal-stretch: 2;

    HorizontalLayout {
        spacing: 10px;

        Rectangle {
            width: 42px;
        }

        HeaderTextCell {
            horizontal-stretch: 1;
            text: "Provider";
            align_center: false;
        }
    }
}

component ProviderListRow inherits Rectangle {
    in property <string> provider_id;
    in property <string> name;
    in property <string> subtitle;
    in property <string> status;
    in property <string> base_url;
    in property <string> model_count;
    in property <string> updated_at;
    in property <bool> selected;
    callback clicked(string);

    height: 64px;
    background: selected ? #f3f2f1 : #ffffff;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        ProviderNameCell {
            name: root.name;
            subtitle: root.subtitle;
        }

        StatusCell {
            status: root.status;
        }

        TextCell {
            text: root.base_url;
        }

        FixedTextCell {
            width: 58px;
            text: root.model_count;
            align_center: true;
        }

        FixedTextCell {
            text: root.updated_at;
            align_center: false;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(root.provider_id); }
    }
}

component DetailLine inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 32px;

    HorizontalLayout {
        spacing: 16px;

        Text {
            width: 140px;
            text: label;
            color: #605e5c;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: value;
            color: #1b1a19;
            font-size: 13px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component ProviderListPanel inherits Rectangle {
    in property <[ProviderRow]> providers;
    in-out property <string> provider_search_text;
    in property <string> selected_provider_id;
    callback add_provider_placeholder();
    callback select_provider(string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: #ffffff;
    border-color: #e1dfdd;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 68px;
            background: #ffffff;

            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 16px;
                padding-right: 16px;

                HorizontalLayout {
                    spacing: 12px;

                    LineEdit {
                        min-width: 190px;
                        horizontal-stretch: 1;
                        height: 36px;
                        text <=> root.provider_search_text;
                        placeholder-text: "Search providers...";
                    }

                    Button {
                        width: 120px;
                        height: 36px;
                        text: "+ Add Provider";
                        clicked => { root.add_provider_placeholder(); }
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            background: #faf9f7;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                ProviderHeaderCell {}

                HeaderTextCell {
                    width: 72px;
                    text: "Status";
                    align_center: true;
                }

                HeaderTextCell {
                    min-width: 120px;
                    horizontal-stretch: 2;
                    text: "Base URL";
                    align_center: false;
                }

                HeaderTextCell {
                    width: 58px;
                    text: "Models";
                    align_center: true;
                }

                HeaderTextCell {
                    width: 88px;
                    text: "Last Updated";
                    align_center: false;
                }
            }
        }

        ScrollView {
            viewport-width: parent.width;

            VerticalLayout {
                spacing: 0px;

                for provider in root.providers : ProviderListRow {
                    provider_id: provider.id;
                    name: provider.name;
                    subtitle: provider.subtitle;
                    status: provider.status;
                    base_url: provider.base_url;
                    model_count: provider.model_count;
                    updated_at: provider.updated_at;
                    selected: provider.id == root.selected_provider_id;
                    clicked(id) => { root.select_provider(id); }
                }
            }
        }

        Rectangle {
            height: 44px;
            border-color: #e1dfdd;
            border-width: 1px;
            background: #faf9f7;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: root.providers.length + " providers";
                    color: #8a8886;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Refresh";
                    color: #0078d4;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component ProviderDetailsCard inherits Rectangle {
    in property <string> selected_provider_id;
    in property <string> selected_provider_name;
    in property <string> selected_provider_subtitle;
    in property <string> selected_provider_status;
    in property <string> selected_provider_base_url;
    in property <string> selected_provider_models;
    in property <string> selected_provider_wire_api;
    in property <string> selected_provider_updated_at;

    height: 256px;
    horizontal-stretch: 1;
    background: #ffffff;
    border-color: #e1dfdd;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 96px;
            background: #ffffff;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 16px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 8px;
                    background: #deecf9;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.selected_provider_name == "OpenAI" ? "AI" : "DS";
                        color: #0078d4;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    min-width: 130px;
                    horizontal-stretch: 1;
                    spacing: 4px;

                    Text {
                        text: root.selected_provider_name;
                        color: #1b1a19;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.selected_provider_subtitle;
                        color: #605e5c;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.selected_provider_base_url;
                        color: #8a8886;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                StatusCell {
                    status: root.selected_provider_status;
                }
            }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 10px;

            DetailLine { label: "Provider ID"; value: root.selected_provider_id; }
            DetailLine { label: "Protocol"; value: root.selected_provider_wire_api; }
            DetailLine { label: "Models"; value: root.selected_provider_models; }
            DetailLine { label: "Last Updated"; value: root.selected_provider_updated_at; }
        }
    }
}

component ProviderEditPlaceholder inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: #ffffff;
    border-color: #e1dfdd;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        padding: 32px;
        spacing: 10px;
        alignment: center;

        Rectangle { vertical-stretch: 1; }

        Text {
            text: "Provider details";
            color: #1b1a19;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: "Select a provider to view details and configure settings.";
            color: #8a8886;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Rectangle { vertical-stretch: 1; }
    }
}

component ProviderDetailColumn inherits Rectangle {
    in property <string> selected_provider_id;
    in property <string> selected_provider_name;
    in property <string> selected_provider_subtitle;
    in property <string> selected_provider_status;
    in property <string> selected_provider_base_url;
    in property <string> selected_provider_models;
    in property <string> selected_provider_wire_api;
    in property <string> selected_provider_updated_at;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: #faf9f7;

    VerticalLayout {
        spacing: 16px;

        ProviderDetailsCard {
            selected_provider_id: root.selected_provider_id;
            selected_provider_name: root.selected_provider_name;
            selected_provider_subtitle: root.selected_provider_subtitle;
            selected_provider_status: root.selected_provider_status;
            selected_provider_base_url: root.selected_provider_base_url;
            selected_provider_models: root.selected_provider_models;
            selected_provider_wire_api: root.selected_provider_wire_api;
            selected_provider_updated_at: root.selected_provider_updated_at;
        }

        ProviderEditPlaceholder {}
    }
}

export component ProviderSettingsPage inherits Rectangle {
    in property <[ProviderRow]> providers;
    in-out property <string> provider_search_text;
    in property <string> selected_provider_id;
    in property <string> selected_provider_name;
    in property <string> selected_provider_subtitle;
    in property <string> selected_provider_status;
    in property <string> selected_provider_base_url;
    in property <string> selected_provider_models;
    in property <string> selected_provider_wire_api;
    in property <string> selected_provider_updated_at;
    callback add_provider_placeholder();
    callback select_provider(string);

    property <bool> compact_layout: root.width < 1060px;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: #faf9f7;

    if !root.compact_layout : HorizontalLayout {
        padding: 24px;
        spacing: 16px;

        ProviderListPanel {
            min-width: 580px;
            horizontal-stretch: 3;
            providers: root.providers;
            provider_search_text <=> root.provider_search_text;
            selected_provider_id: root.selected_provider_id;
            add_provider_placeholder => { root.add_provider_placeholder(); }
            select_provider(id) => { root.select_provider(id); }
        }

        ProviderDetailColumn {
            preferred-width: 400px;
            min-width: 360px;
            horizontal-stretch: 0;
            selected_provider_id: root.selected_provider_id;
            selected_provider_name: root.selected_provider_name;
            selected_provider_subtitle: root.selected_provider_subtitle;
            selected_provider_status: root.selected_provider_status;
            selected_provider_base_url: root.selected_provider_base_url;
            selected_provider_models: root.selected_provider_models;
            selected_provider_wire_api: root.selected_provider_wire_api;
            selected_provider_updated_at: root.selected_provider_updated_at;
        }
    }

    if root.compact_layout : ScrollView {
        viewport-width: parent.width;
        viewport-height: parent.height;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            ProviderListPanel {
                height: 390px;
                providers: root.providers;
                provider_search_text <=> root.provider_search_text;
                selected_provider_id: root.selected_provider_id;
                add_provider_placeholder => { root.add_provider_placeholder(); }
                select_provider(id) => { root.select_provider(id); }
            }

            ProviderDetailColumn {
                height: 610px;
                selected_provider_id: root.selected_provider_id;
                selected_provider_name: root.selected_provider_name;
                selected_provider_subtitle: root.selected_provider_subtitle;
                selected_provider_status: root.selected_provider_status;
                selected_provider_base_url: root.selected_provider_base_url;
                selected_provider_models: root.selected_provider_models;
                selected_provider_wire_api: root.selected_provider_wire_api;
                selected_provider_updated_at: root.selected_provider_updated_at;
            }
        }
    }
}
