import { ChatMessageRow, ProjectRow, ProviderRow, SessionRow } from "types.slint";
import { ChatPage } from "pages/chat_page.slint";
import { SettingsPage } from "pages/settings_page.slint";

export component MainWindow inherits Window {
    title: "Pure Studio";
    preferred-width: 1180px;
    preferred-height: 760px;

    in property <[ProjectRow]> projects;
    in property <[SessionRow]> sessions;
    in property <[ChatMessageRow]> messages;
    in property <[ProviderRow]> providers;
    in-out property <string> manual_project_path;
    in-out property <string> prompt_text;
    in-out property <string> config_toml;
    in-out property <string> provider_search_text;
    in property <string> selected_project_id;
    in property <string> selected_session_id;
    in property <string> selected_provider_id;
    in property <string> selected_provider_name;
    in property <string> selected_provider_subtitle;
    in property <string> selected_provider_status;
    in property <string> selected_provider_base_url;
    in property <string> selected_provider_models;
    in property <string> selected_provider_wire_api;
    in property <string> selected_provider_updated_at;
    in property <string> status_text;
    in property <string> streaming_text;
    in property <string> thinking_text;
    in property <bool> is_busy;
    in property <bool> approval_visible;
    in property <string> approval_id;
    in property <string> approval_text;
    in property <int> active_page;
    in property <int> active_settings_tab;

    callback add_project_dialog();
    callback add_project_path(string);
    callback select_project(string);
    callback new_session();
    callback select_session(string);
    callback send_prompt(string);
    callback save_config(string);
    callback reload_config();
    callback show_chat();
    callback show_settings();
    callback select_settings_tab(int);
    callback add_provider_placeholder();
    callback select_provider(string);
    callback approve_tool(string);
    callback deny_tool(string);

    background: #faf9f7;

    if root.active_page == 0 : ChatPage {
        width: root.width;
        height: root.height;
        projects: root.projects;
        sessions: root.sessions;
        messages: root.messages;
        manual_project_path <=> root.manual_project_path;
        prompt_text <=> root.prompt_text;
        selected_project_id: root.selected_project_id;
        selected_session_id: root.selected_session_id;
        status_text: root.status_text;
        streaming_text: root.streaming_text;
        thinking_text: root.thinking_text;
        is_busy: root.is_busy;
        approval_visible: root.approval_visible;
        approval_id: root.approval_id;
        approval_text: root.approval_text;
        add_project_dialog => { root.add_project_dialog(); }
        add_project_path(path) => { root.add_project_path(path); }
        select_project(project_id) => { root.select_project(project_id); }
        new_session => { root.new_session(); }
        select_session(session_id) => { root.select_session(session_id); }
        send_prompt(prompt) => { root.send_prompt(prompt); }
        show_settings => { root.show_settings(); }
        approve_tool(approval_id) => { root.approve_tool(approval_id); }
        deny_tool(approval_id) => { root.deny_tool(approval_id); }
    }

    if root.active_page == 1 : SettingsPage {
        width: root.width;
        height: root.height;
        providers: root.providers;
        provider_search_text <=> root.provider_search_text;
        selected_provider_id: root.selected_provider_id;
        selected_provider_name: root.selected_provider_name;
        selected_provider_subtitle: root.selected_provider_subtitle;
        selected_provider_status: root.selected_provider_status;
        selected_provider_base_url: root.selected_provider_base_url;
        selected_provider_models: root.selected_provider_models;
        selected_provider_wire_api: root.selected_provider_wire_api;
        selected_provider_updated_at: root.selected_provider_updated_at;
        status_text: root.status_text;
        active_settings_tab: root.active_settings_tab;
        show_chat => { root.show_chat(); }
        select_settings_tab(index) => { root.select_settings_tab(index); }
        add_provider_placeholder => { root.add_provider_placeholder(); }
        select_provider(provider_id) => { root.select_provider(provider_id); }
    }
}
